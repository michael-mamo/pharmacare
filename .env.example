# Copy this file to `.env` and adjust values for your environment.
# Never commit the real `.env` file to version control.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Africa/Addis_Ababa

# --- Database (only used when DJANGO_ENV=production) ------------------
DATABASE_NAME=pharmacare
DATABASE_USER=pharmacare_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Email (only used when DJANGO_ENV=production) ----------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Pharmacy branding --------------------------------------------------
PHARMACY_NAME=PharmaCare Pharmacy
PHARMACY_CURRENCY=ETB
PHARMACY_TAX_RATE=15
PHARMACY_INVOICE_PREFIX=INV-

# --- Account lockout (django-axes) --------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=0.5
