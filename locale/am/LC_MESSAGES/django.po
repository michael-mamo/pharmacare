msgid "Branch"
msgstr "ቅርንጫፍ"

msgid ""
"The branch this person works at. Administrators may leave this blank to work "
"across every branch."
msgstr "ይህ ሰው የሚሰራበት ቅርንጫፍ። አስተዳዳሪዎች በሁሉም ቅርንጫፎች ለመስራት ይህን ባዶ መተው ይችላሉ።"

msgid "Password must contain at least one uppercase letter."
msgstr "የይለፍ ቃል ቢያንስ አንድ ትልቅ ፊደል ሊይዝ ይገባል።"

msgid "Password must contain at least one lowercase letter."
msgstr "የይለፍ ቃል ቢያንስ አንድ ትንሽ ፊደል ሊይዝ ይገባል።"

msgid "Password must contain at least one digit."
msgstr "የይለፍ ቃል ቢያንስ አንድ ቁጥር ሊይዝ ይገባል።"

msgid "Password must contain at least one special character (e.g. !@#$%)."
msgstr "የይለፍ ቃል ቢያንስ አንድ ልዩ ምልክት ሊይዝ ይገባል (ለምሳሌ፦ !@#$%)።"

msgid ""
"Your password must include an uppercase letter, a lowercase letter, a digit, "
"and a special character."
msgstr "የይለፍ ቃልዎ ትልቅ ፊደል፣ ትንሽ ፊደል፣ ቁጥር እና ልዩ ምልክት ማካተት አለበት።"

msgid "Created"
msgstr "ተፈጥሯል"

msgid "Updated"
msgstr "ተዘምኗል"

msgid "Deleted"
msgstr "ተሰርዟል"

msgid "Logged in"
msgstr "ገብቷል"

msgid "Logged out"
msgstr "ወጥቷል"

msgid "Failed login"
msgstr "ያልተሳካ መግቢያ"

msgid "User"
msgstr "ተጠቃሚ"

msgid "Username"
msgstr "የተጠቃሚ ስም"

msgid "Action"
msgstr "እርምጃ"

msgid "Record Type"
msgstr "የመዝገብ አይነት"

msgid "Record ID"
msgstr "የመዝገብ መለያ"

msgid "Record"
msgstr "መዝገብ"

msgid "Details"
msgstr "ዝርዝሮች"

msgid "IP Address"
msgstr "የአይፒ አድራሻ"

msgid "Date"
msgstr "ቀን"

msgid "Audit Log Entry"
msgstr "የኦዲት መዝገብ ግቤት"

msgid "Audit Log"
msgstr "የኦዲት መዝገብ"

msgid "system"
msgstr "ሥርዓት"

msgid ""
"No active branch is available for your account. Ask an Administrator to "
"assign you to a branch."
msgstr "ለመለያዎ ንቁ ቅርንጫፍ አይገኝም። አስተዳዳሪ ወደ ቅርንጫፍ እንዲመድብዎ ይጠይቁ።"

msgid ""
"The main branch cannot be deactivated. Make another branch the main one "
"first."
msgstr "ዋናው ቅርንጫፍ ንቁ ካልሆነ ማድረግ አይቻልም። በቅድሚያ ሌላ ቅርንጫፍ ዋና ያድርጉ።"

msgid "Product"
msgstr "ምርት"

msgid "Destination Branch"
msgstr "መድረሻ ቅርንጫፍ"

msgid "Quantity"
msgstr "ብዛት"

msgid "Reason / Notes"
msgstr "ምክንያት / ማስታወሻዎች"

msgid "e.g. restocking Bole from main store"
msgstr "ለምሳሌ፦ ቦሌን ከዋናው መደብር መሙላት"

#, python-format
msgid "Only %(have)s in stock at %(branch)s."
msgstr "በ%(branch)s ውስጥ %(have)s ብቻ አለ።"

msgid "Enter a valid phone number."
msgstr "ትክክለኛ የስልክ ቁጥር ያስገቡ።"

msgid "Branch Name"
msgstr "የቅርንጫፍ ስም"

msgid "Branch Code"
msgstr "የቅርንጫፍ ኮድ"

msgid "Auto-generated, e.g. BR-001. Appears on invoices and reports."
msgstr "በራስ-ሰር ይፈጠራል፣ ለምሳሌ BR-001። በደረሰኞች እና በሪፖርቶች ላይ ይታያል።"

msgid "Phone"
msgstr "ስልክ"

msgid "Email"
msgstr "ኢሜይል"

msgid "City / Town"
msgstr "ከተማ / ወረዳ"

msgid "Address"
msgstr "አድራሻ"

msgid "Licence Number"
msgstr "የፈቃድ ቁጥር"

msgid "This branch's own operating licence, printed on its invoices."
msgstr "የዚህ ቅርንጫፍ የራሱ የስራ ፈቃድ፣ በደረሰኞቹ ላይ ይታተማል።"

msgid "Branch Manager"
msgstr "የቅርንጫፍ አስተዳዳሪ"

msgid "Invoice Prefix"
msgstr "የደረሰኝ ቅድመ-ቅጥያ"

msgid ""
"Optional. Overrides the pharmacy-wide prefix so each branch's invoice "
"numbers are distinguishable, e.g. BOL-."
msgstr ""
"አማራጭ። የፋርማሲውን አጠቃላይ ቅድመ-ቅጥያ ይተካል፤ በዚህም የየቅርንጫፉ የደረሰኝ ቁጥሮች ይለያሉ፣ ለምሳሌ BOL-።"

msgid "Main Branch"
msgstr "ዋና ቅርንጫፍ"

msgid "The default branch. Exactly one branch is the main one."
msgstr "ነባሪው ቅርንጫፍ። አንድ ቅርንጫፍ ብቻ ዋና ይሆናል።"

msgid "Active"
msgstr "ንቁ"

msgid ""
"Inactive branches keep their history but cannot record new sales, purchases "
"or stock movements."
msgstr ""
"ንቁ ያልሆኑ ቅርንጫፎች ታሪካቸውን ይይዛሉ ግን አዲስ ሽያጭ፣ ግዢ ወይም የክምችት እንቅስቃሴ መመዝገብ አይችሉም።"

msgid "Opened On"
msgstr "የተከፈተበት ቀን"

msgid "Branches"
msgstr "ቅርንጫፎች"

msgid ""
"This branch has sales or purchases recorded and cannot be deleted. Mark it "
"inactive instead."
msgstr ""
"ይህ ቅርንጫፍ የተመዘገቡ ሽያጮች ወይም ግዢዎች አሉት ስለዚህ መሰረዝ አይቻልም። በምትኩ ንቁ እንዳልሆነ ምልክት ያድርጉ።"

msgid "Quantity in Stock"
msgstr "በክምችት ውስጥ ያለ ብዛት"

msgid "Reorder Level"
msgstr "የዳግም ማዘዣ መጠን"

msgid "Per branch, so a busy branch can reorder earlier than a quiet one."
msgstr "በየቅርንጫፉ፤ በዚህም ሥራ የበዛበት ቅርንጫፍ ከጸጥ ካለው ቀድሞ ዳግም ማዘዝ ይችላል።"

msgid "Shelf / Location"
msgstr "መደርደሪያ / ቦታ"

msgid "Where this sits in this particular branch, e.g. 'Aisle 3, Shelf B'."
msgstr "በዚህ ቅርንጫፍ ውስጥ የሚገኝበት ቦታ፣ ለምሳሌ «መተላለፊያ 3፣ መደርደሪያ ለ»።"

msgid "Branch Stock Level"
msgstr "የቅርንጫፍ የክምችት ደረጃ"

msgid "Branch Stock Levels"
msgstr "የቅርንጫፍ የክምችት ደረጃዎች"

msgid ""
"Branch created. Assign staff to it next, and stock it with a purchase or a "
"transfer."
msgstr "ቅርንጫፍ ተፈጥሯል። በመቀጠል ሰራተኞችን ይመድቡ፣ እና በግዢ ወይም በዝውውር ክምችት ያሟሉ።"

msgid "Branch updated."
msgstr "ቅርንጫፍ ተዘምኗል።"

msgid "Your account is fixed to a single branch."
msgstr "መለያዎ በአንድ ቅርንጫፍ ብቻ የተወሰነ ነው።"

msgid "That branch is not available."
msgstr "ያ ቅርንጫፍ አይገኝም።"

#, python-format
msgid "Now working in %(branch)s."
msgstr "አሁን በ%(branch)s ውስጥ ይሠራሉ።"

#, python-format
msgid "Transferred %(qty)s × %(name)s to %(dest)s."
msgstr "%(qty)s × %(name)s ወደ %(dest)s ተዛውሯል።"

msgid "Your Category"
msgstr "የእርስዎ ምድብ"

msgid ""
"How you shelve it. The catalogue's own therapeutic category is kept "
"separately."
msgstr "እርስዎ የሚደረድሩበት መንገድ። የካታሎጉ የራሱ የሕክምና ምድብ በተለየ ይቀመጣል።"

msgid "Supplier"
msgstr "አቅራቢ"

msgid "Purchase Price"
msgstr "የግዢ ዋጋ"

msgid "Selling Price"
msgstr "የሽያጭ ዋጋ"

msgid "Opening Quantity"
msgstr "የመክፈቻ ብዛት"

msgid ""
"Goes to the main branch. Prefer recording a purchase instead, so the cost is "
"tracked properly."
msgstr "ወደ ዋናው ቅርንጫፍ ይሄዳል። በምትኩ ግዢ መመዝገብ ይመረጣል፣ በዚህም ወጪው በአግባቡ ይከታተላል።"

msgid "Expiry Date"
msgstr "የመቆያ ጊዜ ማብቂያ"

msgid "Batch Number"
msgstr "የጭነት ቁጥር"

msgid "VAT (%)"
msgstr "ተ.እ.ታ (%)"

msgid ""
"This is below the purchase price, so every sale would lose money. Change it, "
"or confirm it is deliberate by entering it again."
msgstr ""
"ይህ ከግዢ ዋጋው በታች ነው፣ ስለዚህ እያንዳንዱ ሽያጭ ኪሳራ ያመጣል። ይቀይሩት፣ ወይም ሆን ተብሎ መሆኑን ደግመው "
"በማስገባት ያረጋግጡ።"

msgid ""
"Only fill this in from the EFDA register. Leave blank if you do not have the "
"number — a wrong registration number is worse than none."
msgstr ""
"ይህን የሚሞሉት ከEFDA መዝገብ ብቻ ነው። ቁጥሩ ከሌለዎት ባዶ ይተዉት — የተሳሳተ የምዝገባ ቁጥር ከምንም የከፋ ነው።"

msgid "Enter a valid ATC code, e.g. N02BE01 or a partial code like N02BE."
msgstr "ትክክለኛ የATC ኮድ ያስገቡ፣ ለምሳሌ N02BE01 ወይም እንደ N02BE ያለ ከፊል ኮድ።"

msgid "Tablet"
msgstr "ታብሌት"

msgid "Capsule"
msgstr "ካፕሱል"

msgid "Syrup"
msgstr "ሽሮፕ"

msgid "Suspension"
msgstr "ሳስፐንሽን"

msgid "Solution"
msgstr "መፍትሔ"

msgid "Injection"
msgstr "መርፌ"

msgid "Infusion"
msgstr "ኢንፊውዥን"

msgid "Cream"
msgstr "ክሬም"

msgid "Ointment"
msgstr "ቅባት"

msgid "Gel"
msgstr "ጄል"

msgid "Drops"
msgstr "ጠብታ"

msgid "Inhaler"
msgstr "ኢንሄለር"

msgid "Suppository"
msgstr "ሱፖዚቶሪ"

msgid "Pessary"
msgstr "ፔሳሪ"

msgid "Patch"
msgstr "ፕላስተር"

msgid "Powder"
msgstr "ዱቄት"

msgid "Sachet"
msgstr "ከረጢት"

msgid "Device"
msgstr "መሳሪያ"

msgid "Dressing"
msgstr "ማሰሪያ"

msgid "Other"
msgstr "ሌላ"

msgid "Oral"
msgstr "በአፍ"

msgid "Topical"
msgstr "በቆዳ ላይ"

msgid "Intravenous"
msgstr "በደም ሥር"

msgid "Intramuscular"
msgstr "በጡንቻ"

msgid "Subcutaneous"
msgstr "ከቆዳ በታች"

msgid "Eye"
msgstr "ለዓይን"

msgid "Ear"
msgstr "ለጆሮ"

msgid "Nasal"
msgstr "ለአፍንጫ"

msgid "Inhaled"
msgstr "በመተንፈስ"

msgid "Rectal"
msgstr "በፊንጢጣ"

msgid "Vaginal"
msgstr "በሴት ብልት"

msgid "Not applicable"
msgstr "አይመለከትም"

msgid "EFDA register"
msgstr "የEFDA መዝገብ"

msgid "WHO Essential Medicines List"
msgstr "የWHO አስፈላጊ መድሃኒቶች ዝርዝር"

msgid "Bundled starter set (verify before regulatory use)"
msgstr "አብሮ የቀረበ የመጀመሪያ ስብስብ (ለቁጥጥር አገልግሎት ከመዋሉ በፊት ያረጋግጡ)"

msgid "Added locally"
msgstr "በአካባቢው የተጨመረ"

msgid "Over the counter"
msgstr "ያለ ማዘዣ የሚሸጥ"

msgid "Prescription only"
msgstr "በማዘዣ ብቻ"

msgid "Controlled substance"
msgstr "ቁጥጥር የሚደረግበት"

msgid "Name"
msgstr "ስም"

msgid "Code"
msgstr "ኮድ"

msgid "Description"
msgstr "መግለጫ"

msgid "Sort Order"
msgstr "የማስተካከያ ቅደም ተከተል"

msgid "Catalogue Category"
msgstr "የካታሎግ ምድብ"

msgid "Catalogue Categories"
msgstr "የካታሎግ ምድቦች"

msgid "Generic Name (INN)"
msgstr "አጠቃላይ ስም (INN)"

msgid ""
"International non-proprietary name, e.g. Paracetamol. This is the name "
"reporting groups by, so it must not carry a brand."
msgstr ""
"ዓለም አቀፍ አጠቃላይ ስም፣ ለምሳሌ ፓራሲታሞል። ሪፖርት የሚደረግበት ስም ይህ ነው፣ ስለዚህ የምርት ስያሜ መያዝ "
"የለበትም።"

msgid "Brand Name"
msgstr "የምርት ስያሜ"

msgid "Leave blank for a generic entry."
msgstr "ለአጠቃላይ ግቤት ባዶ ይተዉት።"

msgid "Strength"
msgstr "የመጠን ጥንካሬ"

msgid "Include units, e.g. 500mg, 125mg/5ml, 0.9%."
msgstr "አሃዶችን ያካትቱ፣ ለምሳሌ 500mg፣ 125mg/5ml፣ 0.9%።"

msgid "Dosage Form"
msgstr "የመድሃኒት ቅርጽ"

msgid "Route"
msgstr "የመስጫ መንገድ"

msgid "ATC Code"
